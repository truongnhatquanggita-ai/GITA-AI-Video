    "db:migrate:remote": "wrangler d1 migrations apply gita-ai-v50 --remote",
    "test": "node --test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
